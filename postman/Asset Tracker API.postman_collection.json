{
  "info": {
    "name": "Asset Tracker API",
    "description": "Collection for the Asset Tracker backend. Run the Login request first; it stores the JWT in the collection token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "assetTagNumber",
      "value": "21000004-00"
    },
    {
      "key": "otherCompanyAssetTagNumber",
      "value": "31000001-00"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - admin COMP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.test('JWT token was saved', function () {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - worker COMP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"worker\",\n  \"password\": \"Worker123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - viewer COMP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('viewerToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewer\",\n  \"password\": \"Viewer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - admin OTHR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"othr_admin\",\n  \"password\": \"Othr123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - invalid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Assets",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List assets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            }
          }
        },
        {
          "name": "Get asset by tag",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetTagNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetTagNumber}}"
              ]
            }
          }
        },
        {
          "name": "Get asset history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetTagNumber}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetTagNumber}}",
                "history"
              ]
            }
          }
        },
        {
          "name": "Create asset - admin only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetTagNumber\": \"21000006-00\",\n  \"companyCode\": \"COMP\",\n  \"mainAssetNumber\": \"21000006\",\n  \"assetSubNumber\": \"00\",\n  \"description\": \"New warehouse scanner\",\n  \"costCenter\": \"CC-1000\",\n  \"statusId\": \"01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            }
          }
        },
        {
          "name": "Update status - worker or admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statusId\": \"02\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetTagNumber}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetTagNumber}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Cross-company asset should return 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{otherCompanyAssetTagNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{otherCompanyAssetTagNumber}}"
              ]
            }
          }
        },
        {
          "name": "Viewer update should return 403",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{viewerToken}}",
                "type": "string"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('viewerToken')) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ username: 'viewer', password: 'Viewer123!' }) }",
                  "    }, function (error, response) {",
                  "        if (!error) pm.collectionVariables.set('viewerToken', response.json().token);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statusId\": \"01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetTagNumber}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetTagNumber}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}
